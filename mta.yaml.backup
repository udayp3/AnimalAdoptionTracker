_schema-version: "3.3.0"

ID: AnimalAdoptionTracker
version: 1.0.0
description: Animal Adoption Tracker

parameters:
  enable-parallel-deployments: true

build-parameters:
  before-all:
    - builder: custom
      commands:
        - npm ci
        - npx cds build --production

modules:

  - name: AnimalAdoptionTracker-srv
    type: nodejs
    path: gen/srv
    parameters:
      memory: 1024M
      disk-quota: 1024M
      instances: 1
    provides:
      - name: srv-api
        properties:
          srv-url: ${default-url}
    requires:
      - name: AnimalAdoptionTracker-db
      - name: AnimalAdoptionTracker-auth
      - name: AnimalAdoptionTracker-destination

  - name: AnimalAdoptionTracker-db-deployer
    type: hdb
    path: gen/db
    parameters:
      buildpack: nodejs_buildpack
    requires:
      - name: AnimalAdoptionTracker-db

resources:

  - name: AnimalAdoptionTracker-db
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared

  - name: AnimalAdoptionTracker-auth
    type: org.cloudfoundry.managed-service
    parameters:
      service: xsuaa
      service-plan: application
      path: ./xs-security.json

  - name: AnimalAdoptionTracker-destination
    type: org.cloudfoundry.managed-service
    parameters:
      service: destination
      service-plan: lite